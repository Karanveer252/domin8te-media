# Domin8te Media
#
# The host's default is Cache-Control: public, max-age=604800 on everything,
# which means a returning visitor keeps a week-old stylesheet and script after
# a deploy and a normal refresh will not shift it. Two rules fix that:
# the HTML always revalidates, and the assets it points at are versioned, so
# they can safely be cached hard and forever.

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # referenced with ?v= build tokens, so a new build is always a new URL
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # not versioned, so keep these short enough to re-pull within a day
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff2|mp4|json)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# the form handler must never be cached
<FilesMatch "^send\.php$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-store"
  </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# no directory listings anywhere
Options -Indexes
